# Gitleaks configuration for repos bootstrapped by agent-history-hygiene.
#
# Source of truth: ~/.local/share/chezmoi/.gitleaks.toml. This file is a
# portable subset copied in by `bootstrap-project.sh` for repos without
# chezmoi. Keep rule IDs stable so allowlists stay comparable.
#
# https://github.com/gitleaks/gitleaks#configuration

title = "agent-history-hygiene gitleaks config"

[extend]
useDefault = true

# Global allowlist: redaction sentinels + example-shape strings the agent
# legitimately discusses in transcripts/plans. Uses the [[allowlists]]
# array form (gitleaks v8 forbids mixing with the deprecated [allowlist]).
[[allowlists]]
  description = "Redaction sentinels + documentation-shape keys"
  regexTarget = "line"
  regexes = [
    # Already-redacted sentinels emitted by redact_secrets.py.
    '''\b[A-Za-z0-9_-]+_REDACTED(?:_[A-Z_]+)?\b''',
    # Truncated "sk-proj-XXX..." example shapes used in prose.
    '''sk-[a-zA-Z0-9]{3,8}\.\.\.''',
  ]

# Shared redaction sentinel: `[REDACTED:<rule-id>]` is what redact_secrets.py
# writes AND what SpecStory >= 2.4.0 writes natively (its binary carries the
# format string `[REDACTED:%s]`). Allowlisting it keeps the two layers
# idempotent -- neither re-flags the other's output, so pre-commit stops
# rewriting transcripts on every commit.
#
# regexTarget = "match" on purpose: at "line" scope a line holding both a
# placeholder and a live key would be allowlisted wholesale. Matching the
# finding's own bytes means only an inert placeholder is ever suppressed.
[[allowlists]]
  description = "Shared [REDACTED:<rule-id>] sentinel (ours + SpecStory native)"
  regexTarget = "match"
  regexes = [
    '''\[REDACTED:[A-Za-z0-9._-]+\]''',
  ]

# The upstream sourcegraph-access-token rule deliberately accepts any bare
# 40-hex value when a `sourcegraph` keyword appears in the scanned fragment.
# Agent transcripts routinely contain both the rule name (from scanner output)
# and full Git commit OIDs, so archival history otherwise produces hundreds of
# false positives. Scope the exception to this one rule AND artifact paths AND
# the finding's exact Secret bytes. A real `sgp_...` token does not match the
# bare-hex regex and still fires; the same 40-hex value outside artifacts also
# still fires. Omitting regexTarget uses gitleaks' Secret target, which excludes
# the rule's trailing delimiter from Match.
[[allowlists]]
  description = "Bare Git commit OIDs in agent artifacts are not Sourcegraph tokens"
  targetRules = ["sourcegraph-access-token"]
  condition   = "AND"
  paths = [
    '''\.specstory/history/.*\.md$''',
    '''\.claude/plans/.*\.md$''',
    '''\.cursor/(plans|rules)/.*\.md$''',
    '''\.opencode/plans/.*\.md$''',
    '''\.specify/.*\.md$''',
    '''\.codex/.*\.md$''',
  ]
  regexes = [
    '''(?i)^[a-f0-9]{40}$''',
  ]

# Path-scoped allowlist: inside agent artifact dirs, tolerate explicit
# example/demo markers without unlocking real leaks.
#
# regexTarget = "match" is load-bearing, NOT cosmetic. At "line" scope a single
# line holding BOTH a placeholder and a live credential -- e.g. a partially
# redacted env dump like
#   ANTHROPIC_API_KEY=[REDACTED:anthropic-api-key] GITHUB_TOKEN=ghp_<live>
# -- was allowlisted wholesale, so the live token never fired. Transcripts
# produce exactly that shape whenever a tool echoes a multi-value line.
# Matching the finding's OWN bytes means only an inert placeholder is ever
# suppressed; a real credential beside one still fires.
#
# `condition = "AND"` stays required: it is what keeps `paths` from
# allowlisting these directories wholesale (gitleaks v8 allowlists default to
# OR between path and regex). Match-scoping and AND are both load-bearing --
# AND keeps the directory from being blanket-trusted, match-scoping keeps a
# tolerated placeholder from covering the rest of its line.
[[allowlists]]
  description = "Example/demo keys inside agent transcripts and plan files"
  condition   = "AND"
  paths = [
    '''\.specstory/history/.*\.md$''',
    '''\.claude/plans/.*\.md$''',
    '''\.cursor/(plans|rules)/.*\.md$''',
    '''\.opencode/plans/.*\.md$''',
    '''\.specify/.*\.md$''',
    '''\.codex/.*\.md$''',
  ]
  regexTarget = "match"
  regexes = [
    '''example[-_]?(key|token|secret)''',
    '''\bREDACTED\b''',
    '''sk-[a-zA-Z0-9]{3,8}\.\.\.''',
    '''your[-_]?(api[-_]?)?key[-_]?here''',
  ]

# ---------------------------------------------------------------------------
# Custom rules -- prefix-anchored modern API keys gitleaks default rules miss
# or under-specify. Curated subset of the chezmoi config; rule IDs match so
# overrides in the user's chezmoi version remain compatible.
# ---------------------------------------------------------------------------

[[rules]]
  id          = "openai-project-key"
  description = "OpenAI project-scoped API key (sk-proj-...)"
  regex       = '''\bsk-proj-[A-Za-z0-9_-]{80,}\b'''
  tags        = ["key", "openai", "auto"]

[[rules]]
  id          = "anthropic-api-key-strict"
  description = "Anthropic API key (sk-ant-apiNN-..., strict length)"
  regex       = '''\bsk-ant-api\d{2}-[A-Za-z0-9_-]{93}AA\b'''
  tags        = ["key", "anthropic", "auto"]

[[rules]]
  id          = "cursor-api-key"
  description = "Cursor API key (cursor- prefixed)"
  regex       = '''\bcursor-[A-Za-z0-9]{40,}\b'''
  tags        = ["key", "cursor", "auto"]

[[rules]]
  id          = "huggingface-token"
  description = "Hugging Face user access token (hf_...)"
  regex       = '''\bhf_[A-Za-z0-9]{34,40}\b'''
  tags        = ["key", "huggingface", "auto"]

[[rules]]
  id          = "supabase-service-pat"
  description = "Supabase service / personal access token (sbp_...)"
  regex       = '''\bsbp_[a-f0-9]{40}\b'''
  tags        = ["key", "supabase", "auto"]

[[rules]]
  id          = "linear-api-key"
  description = "Linear API key (lin_api_...)"
  regex       = '''\blin_api_[A-Za-z0-9]{40}\b'''
  tags        = ["key", "linear", "auto"]

[[rules]]
  id          = "tailscale-auth-key"
  description = "Tailscale auth/client/api key (tskey-...)"
  regex       = '''\btskey-(?:auth|client|api)-[A-Za-z0-9]+-[A-Za-z0-9]{24,}\b'''
  tags        = ["key", "tailscale", "auto"]

[[rules]]
  id          = "notion-integration-token"
  description = "Notion internal integration token (ntn_...)"
  regex       = '''\bntn_[A-Za-z0-9]{40,}\b'''
  tags        = ["key", "notion", "auto"]

[[rules]]
  id          = "wakatime-api-key"
  description = "WakaTime API key (waka_ + RFC-4122 UUID)"
  regex       = '''\bwaka_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b'''
  tags        = ["key", "wakatime", "auto"]

[[rules]]
  id          = "grafana-service-account-token"
  description = "Grafana service-account token (glsa_<32 chars>_<8 hex crc>)"
  # Fixed format `glsa_<32 alnum>_<8 hex crc>` -- strict enough that the
  # redaction sentinel `glsa_<REDACTED>` and doc placeholders (glsa_xxx)
  # never match. Grafana service-account tokens get pasted into transcripts
  # whenever someone wires up the Grafana MCP (GRAFANA_SERVICE_ACCOUNT_TOKEN).
  regex       = '''\bglsa_[A-Za-z0-9]{32}_[0-9a-f]{8}\b'''
  tags        = ["key", "grafana", "auto"]

# ---------------------------------------------------------------------------
# Webhook URLs commonly emitted into LLM/agent transcripts during demos and
# test scaffolding. gitleaks default rules cover slack-webhook-url,
# microsoft-teams-webhook, and telegram-bot-api-token; these fill the gaps.
# ---------------------------------------------------------------------------

[[rules]]
  id          = "discord-webhook-url"
  description = "Discord webhook URL (discord.com / discordapp.com / ptb / canary)"
  regex       = '''https?://(?:(?:ptb|canary)\.)?discord(?:app)?\.com/api/webhooks/\d{17,20}/[A-Za-z0-9_-]{60,80}'''
  tags        = ["webhook", "discord", "auto"]

[[rules]]
  id          = "zapier-webhook-url"
  description = "Zapier catch hook URL (hooks.zapier.com/hooks/catch/...)"
  regex       = '''https?://hooks\.zapier\.com/hooks/catch/\d{6,12}/[A-Za-z0-9]{5,}/?'''
  tags        = ["webhook", "zapier", "auto"]

[[rules]]
  id          = "make-webhook-url"
  description = "Make.com / Integromat webhook URL"
  regex       = '''https?://hook\.(?:[a-z]{2}\d+\.make\.com|integromat\.com)/[A-Za-z0-9]{20,}'''
  tags        = ["webhook", "make", "integromat", "auto"]

[[rules]]
  id          = "stripe-webhook-secret"
  description = "Stripe webhook signing secret (whsec_...)"
  regex       = '''\bwhsec_[A-Za-z0-9]{32,}\b'''
  tags        = ["webhook", "stripe", "auto"]

# ---------------------------------------------------------------------------
# Local-encryption + generic credential shapes. Both were promoted here from a
# downstream repo (tarlin-infra) after real transcripts hit them: an age
# identity copied between machines, and sudo/root passwords pasted into chat
# while walking through an on-box deploy.
# ---------------------------------------------------------------------------

[[rules]]
  id          = "age-secret-key"
  description = "age encryption identity / private key (AGE-SECRET-KEY-1...)"
  # Matters wherever age/sops/chezmoi encryption is used: the private identity
  # is the ONE secret that cannot be rotated cheaply, because it decrypts every
  # committed encrypted_*.age blob in the repo's history.
  regex       = '''AGE-SECRET-KEY-1[0-9A-Z]{50,64}'''
  tags        = ["key", "age", "auto"]

[[rules]]
  id          = "generic-password-assignment"
  description = "Password / passphrase / sudo password assignment"
  # [ \t]* (not \s*) around [:=] is deliberate. With \s*, prose like
  #     "...needs a sudo password:\n  bin/foo-bar"
  # (a help-text bullet, not an assignment) matched with secret="bin/foo-bar",
  # because \s* let the separator swallow the newline and treat the next line's
  # first word as the value. Real single-line assignments (`password: hunter2`,
  # `passwd=hunter2`) are unaffected.
  regex       = '''(?i)(?:passwo?r?d|passphrase|sudo[_-]?pass(?:word)?)[ \t]*[:=][ \t]*["']?([^\s"'#]{6,})'''
  secretGroup = 1
  tags        = ["password", "auto"]
